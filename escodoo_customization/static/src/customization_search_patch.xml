<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="escodoo_customization.SearchBar"
        t-inherit="web.SearchBar"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_searchview_input_container')]" position="inside">
            <t t-if="showCustomizationSearchFields">
                <t
                    t-foreach="customizationSearchFields"
                    t-as="item"
                    t-key="item.id"
                >
                    <button
                        type="button"
                        class="btn btn-sm btn-link o_esc_customization_target px-1"
                        t-att-title="item.fieldName"
                        t-on-click.prevent.stop="(ev) => this.onCustomizationSearchFieldClick(ev, item)"
                        t-esc="item.description"
                    />
                </t>
            </t>
        </xpath>
    </t>
</templates>
