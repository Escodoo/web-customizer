<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_customization" model="ir.module.category">
        <field name="name">Customization</field>
        <field name="sequence">52</field>
    </record>

    <record id="group_customization_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_customization" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_customization_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_customization" />
        <field name="implied_ids" eval="[(4, ref('group_customization_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_customization_user'))]" />
    </record>

    <record id="customization_bundle_company_rule" model="ir.rule">
        <field name="name">Customization Bundle: multi-company</field>
        <field name="model_id" ref="model_customization_bundle" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="customization_operation_company_rule" model="ir.rule">
        <field name="name">Customization Operation: multi-company</field>
        <field name="model_id" ref="model_customization_operation" />
        <field
            name="domain_force"
        >['|', ('bundle_id.company_id', '=', False), ('bundle_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
