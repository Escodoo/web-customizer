<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_customizer.FieldDialog">
        <Dialog title="title" size="'md'">
            <div class="o_esc_customization_dialog">
                <p class="text-muted" t-if="state.candidates.length > 1">
                    Anchor "<t t-esc="props.fieldName" />" matches
                    <t t-esc="state.anchorCount" /> nodes. Choose which one
                    to customize.
                </p>
                <p class="text-danger" t-if="state.loadError" t-esc="state.loadError" />
                <p class="text-danger" t-if="!state.subviewInline">
                    The "<t t-esc="props.anchorSubview" />" table is not written
                    in this view, so it cannot be customized from here. Open the
                    <t t-esc="props.model" /> list view instead.
                </p>
                <p
                    class="text-danger"
                    t-if="!state.loadError and !state.bundles.length"
                >
                    Create a bundle under Settings → Technical → Customization
                    before customizing this form.
                </p>
                <div class="mb-3" t-if="state.candidates.length > 1">
                    <label class="form-label">Which node</label>
                    <select class="form-select" t-on-change="onCandidateChange">
                        <t
                            t-foreach="state.candidates"
                            t-as="candidate"
                            t-key="candidate.index"
                        >
                            <option
                                t-att-value="candidate.index"
                                t-att-selected="candidate.index === state.anchorIndex"
                                t-esc="candidate.label"
                            />
                        </t>
                    </select>
                </div>
                <div class="mb-3" t-if="state.bundles.length">
                    <label class="form-label">Bundle</label>
                    <select class="form-select" t-on-change="onBundleChange">
                        <t t-foreach="state.bundles" t-as="bundle" t-key="bundle.id">
                            <option
                                t-att-value="bundle.id"
                                t-att-selected="bundle.id === state.bundleId"
                                t-esc="bundle.name"
                            />
                        </t>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Action</label>
                    <select
                        class="form-select o_esc_action_select"
                        t-on-change="(ev) => state.action = ev.target.value"
                    >
                        <t t-foreach="actions" t-as="act" t-key="act.value">
                            <option
                                t-att-value="act.value"
                                t-att-selected="state.action === act.value"
                                t-esc="act.label"
                            />
                        </t>
                    </select>
                </div>
                <t t-if="state.action === 'set_view_attribute'">
                    <p class="text-muted" t-if="tableTarget">
                        These options apply to the
                        <t t-esc="props.fieldLabel or props.fieldName" /> table,
                        not to the record around it.
                    </p>
                    <p class="text-muted">
                        Leave an option untouched to keep what the view already
                        does.
                    </p>
                    <div
                        class="mb-3"
                        t-foreach="rootActionOptions"
                        t-as="opt"
                        t-key="opt[0]"
                    >
                        <label class="form-label" t-esc="opt[2]" />
                        <select
                            class="form-select"
                            t-on-change="(ev) => state[opt[0]] = ev.target.value"
                        >
                            <option
                                value=""
                                t-att-selected="!state[opt[0]]"
                            >Leave as is</option>
                            <option
                                value="1"
                                t-att-selected="state[opt[0]] === '1'"
                            >Allowed</option>
                            <option
                                value="0"
                                t-att-selected="state[opt[0]] === '0'"
                            >Not allowed</option>
                        </select>
                    </div>
                    <div
                        class="mb-3"
                        t-foreach="rootFlagOptions"
                        t-as="opt"
                        t-key="opt[0]"
                    >
                        <label class="form-label" t-esc="opt[2]" />
                        <select
                            t-attf-class="form-select o_esc_root_#{opt[1]}"
                            t-on-change="(ev) => state[opt[0]] = ev.target.value"
                        >
                            <option
                                value=""
                                t-att-selected="!state[opt[0]]"
                            >Leave as is</option>
                            <option
                                value="1"
                                t-att-selected="state[opt[0]] === '1'"
                            >Allowed</option>
                            <option
                                value="0"
                                t-att-selected="state[opt[0]] === '0'"
                            >Not allowed</option>
                        </select>
                    </div>
                    <div class="mb-3" t-if="isListView">
                        <label class="form-label">Inline editing</label>
                        <select
                            class="form-select o_esc_root_editable"
                            t-on-change="(ev) => state.rootEditable = ev.target.value"
                        >
                            <option
                                value=""
                                t-att-selected="!state.rootEditable"
                            >Leave as is</option>
                            <option
                                value="top"
                                t-att-selected="state.rootEditable === 'top'"
                            >New rows on top</option>
                            <option
                                value="bottom"
                                t-att-selected="state.rootEditable === 'bottom'"
                            >New rows at the bottom</option>
                            <option
                                value="off"
                                t-att-selected="state.rootEditable === 'off'"
                            >Off</option>
                        </select>
                    </div>
                    <div class="mb-3" t-if="targetViewType !== 'form'">
                        <label class="form-label">Default order (optional)</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="create_date desc"
                            t-att-value="state.rootDefaultOrder"
                            t-on-input="(ev) => state.rootDefaultOrder = ev.target.value"
                        />
                    </div>
                    <div class="mb-3" t-if="isListView">
                        <label class="form-label">Row colour (optional)</label>
                        <select
                            class="form-select mb-2"
                            t-on-change="(ev) => state.rootDecoration = ev.target.value"
                        >
                            <t t-foreach="decorations" t-as="deco" t-key="deco">
                                <option
                                    t-att-value="deco"
                                    t-att-selected="state.rootDecoration === deco"
                                    t-esc="deco"
                                />
                            </t>
                        </select>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="state == 'draft'"
                            t-att-value="state.rootDecorationCondition"
                            t-on-input="(ev) => state.rootDecorationCondition = ev.target.value"
                        />
                        <div class="form-text">
                            The condition is evaluated against each record.
                        </div>
                    </div>
                </t>
                <t t-if="state.action === 'add_after'">
                    <div class="mb-3" t-if="!state.related">
                        <label class="form-label">Field type</label>
                        <select
                            class="form-select"
                            t-on-change="(ev) => state.ttype = ev.target.value"
                        >
                            <t t-foreach="fieldTypes" t-as="ftype" t-key="ftype[0]">
                                <option
                                    t-att-value="ftype[0]"
                                    t-att-selected="state.ttype === ftype[0]"
                                    t-esc="ftype[1]"
                                />
                            </t>
                        </select>
                        <div class="form-text text-warning" t-esc="ttypeDataLossHint" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Label</label>
                        <input
                            type="text"
                            class="form-control"
                            t-att-value="state.string"
                            t-on-input="(ev) => state.string = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Technical name (optional)</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="x_cust_..."
                            t-att-value="state.name"
                            t-on-input="(ev) => state.name = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Related path (optional)</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="parent_id.email"
                            t-att-value="state.related"
                            t-on-input="(ev) => state.related = ev.target.value"
                        />
                    </div>
                    <div class="form-check mb-3" t-if="state.related">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="esc_cust_store"
                            t-att-checked="state.storeRelated"
                            t-on-change="(ev) => state.storeRelated = ev.target.checked"
                        />
                        <label class="form-check-label" for="esc_cust_store">
                            Store related value
                        </label>
                    </div>
                    <div
                        class="mb-3"
                        t-if="!state.related &amp;&amp; (state.ttype === 'many2one' || state.ttype === 'many2many')"
                    >
                        <label class="form-label">Relation model</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="res.partner"
                            t-att-value="state.relation"
                            t-on-input="(ev) => state.relation = ev.target.value"
                        />
                    </div>
                    <div
                        class="mb-3"
                        t-if="!state.related &amp;&amp; state.ttype === 'selection'"
                    >
                        <label class="form-label">Selection options</label>
                        <textarea
                            class="form-control"
                            rows="4"
                            placeholder="draft:Draft"
                            t-att-value="state.selectionOptions"
                            t-on-input="(ev) => state.selectionOptions = ev.target.value"
                        />
                        <div class="form-text">
                            One option per line as value:Label.
                        </div>
                    </div>
                    <div
                        class="mb-3"
                        t-if="!state.related &amp;&amp; state.ttype === 'monetary'"
                    >
                        <label class="form-label">Currency field (optional)</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="currency_id"
                            t-att-value="state.currencyField"
                            t-on-input="(ev) => state.currencyField = ev.target.value"
                        />
                        <div class="form-text">
                            Required unless the model already has currency_id
                            or x_currency_id.
                        </div>
                    </div>
                </t>
                <t t-if="state.action === 'add_filter'">
                    <div class="mb-3">
                        <label class="form-label">Filter label</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="Active Customers"
                            t-att-value="state.string"
                            t-on-input="(ev) => state.string = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Domain</label>
                        <input
                            type="text"
                            class="form-control font-monospace"
                            placeholder="[('active', '=', True)]"
                            t-att-value="state.filterDomain"
                            t-att-disabled="state.filterGroupBy.trim() ? 'disabled' : false"
                            t-on-input="(ev) => state.filterDomain = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">or group by field</label>
                        <input
                            type="text"
                            class="form-control font-monospace"
                            placeholder="user_id"
                            t-att-value="state.filterGroupBy"
                            t-att-disabled="state.filterDomain.trim() ? 'disabled' : false"
                            t-on-input="(ev) => state.filterGroupBy = ev.target.value"
                        />
                        <div class="form-text">
                            A filter either narrows the records with a domain or
                            groups them by a field, never both.
                        </div>
                    </div>
                </t>
                <t t-if="state.action === 'add_page' || state.action === 'add_group'">
                    <div class="mb-3">
                        <label class="form-label">
                            <t t-if="state.action === 'add_page'">Page title</t>
                            <t t-else="">Group label</t>
                        </label>
                        <input
                            type="text"
                            class="form-control"
                            t-att-value="state.string"
                            t-on-input="(ev) => state.string = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Technical name (optional)</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="x_cust_..."
                            t-att-value="state.name"
                            t-on-input="(ev) => state.name = ev.target.value"
                        />
                    </div>
                </t>
                <t t-if="state.action === 'add_button'">
                    <div class="mb-3">
                        <label class="form-label">Button label</label>
                        <input
                            type="text"
                            class="form-control o_esc_button_label"
                            t-att-value="state.string"
                            t-on-input="(ev) => state.string = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Action to call</label>
                        <RecordSelector
                            resId="state.actionId"
                            resModel="'ir.actions.actions'"
                            update.bind="onWindowActionUpdate"
                            fieldString.translate="Action"
                            placeholder.translate="Search an action..."
                        />
                        <div class="form-text">
                            The action must have an XML ID. A server action runs on
                            the record; a window action opens its view.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Style</label>
                        <select
                            class="form-select o_esc_button_class"
                            t-model="state.buttonClass"
                        >
                            <option value="btn-secondary">Secondary</option>
                            <option value="btn-primary">Primary</option>
                            <option value="btn-link">Link</option>
                        </select>
                    </div>
                </t>
                <t t-if="state.action === 'add_menu' || state.action === 'add_submenu'">
                    <div class="mb-3">
                        <label class="form-label">Menu label</label>
                        <input
                            type="text"
                            class="form-control"
                            t-att-value="state.string"
                            t-on-input="(ev) => state.string = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Window action</label>
                        <RecordSelector
                            resId="state.actionId"
                            resModel="'ir.actions.act_window'"
                            update.bind="onWindowActionUpdate"
                            fieldString.translate="Window action"
                            placeholder.translate="Search a window action..."
                        />
                        <div class="form-text">
                            The action must have an XML ID.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Technical name (optional)</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="menu_people"
                            t-att-value="state.name"
                            t-on-input="(ev) => state.name = ev.target.value"
                        />
                    </div>
                </t>
                <t
                    t-if="state.action === 'move_menu' || state.action === 'move_as_submenu'"
                >
                    <div class="mb-3">
                        <label class="form-label">Destination menu</label>
                        <RecordSelector
                            resId="state.targetMenuId"
                            resModel="'ir.ui.menu'"
                            domain="destinationMenuDomain"
                            update.bind="onTargetMenuUpdate"
                            fieldString.translate="Destination menu"
                            placeholder.translate="Search a menu..."
                        />
                        <div class="form-text">
                            The destination menu must have an XML ID.
                        </div>
                    </div>
                </t>
                <t
                    t-if="state.action === 'place_after' || state.action === 'move_after'"
                >
                    <div class="mb-3">
                        <label class="form-label">Existing field</label>
                        <RecordSelector
                            resId="state.existingFieldId"
                            resModel="'ir.model.fields'"
                            domain="existingFieldDomain"
                            update.bind="onExistingFieldUpdate"
                            fieldString.translate="Existing field"
                            placeholder.translate="Search a field..."
                        />
                        <div class="form-text" t-if="state.action === 'move_after'">
                            The field must already be in this view. It is
                            relocated, not duplicated.
                        </div>
                    </div>
                </t>
                <t t-if="state.action === 'rename'">
                    <div class="mb-3">
                        <label class="form-label">New label</label>
                        <input
                            type="text"
                            class="form-control"
                            t-att-value="state.newLabel"
                            t-on-input="(ev) => state.newLabel = ev.target.value"
                        />
                    </div>
                </t>
                <t t-if="state.action === 'set_default'">
                    <div class="mb-3" t-if="isMany2oneDefault">
                        <label class="form-label">Default record</label>
                        <RecordSelector
                            resId="state.defaultRecordId"
                            resModel="state.fieldRelation"
                            update.bind="onDefaultRecordUpdate"
                            fieldString.translate="Default record"
                            placeholder.translate="Search a record..."
                        />
                    </div>
                    <div class="mb-3" t-elif="isBooleanDefault">
                        <label class="form-label">Default value</label>
                        <select
                            class="form-select o_esc_default_value"
                            t-on-change="(ev) => state.defaultValue = ev.target.value"
                        >
                            <option
                                value="false"
                                t-att-selected="state.defaultValue !== 'true'"
                            >False</option>
                            <option
                                value="true"
                                t-att-selected="state.defaultValue === 'true'"
                            >True</option>
                        </select>
                    </div>
                    <div class="mb-3" t-else="">
                        <label class="form-label">Default value</label>
                        <input
                            type="text"
                            class="form-control o_esc_default_value"
                            t-att-value="state.defaultValue"
                            t-on-input="(ev) => state.defaultValue = ev.target.value"
                        />
                    </div>
                    <div class="form-text">
                        Applies to every new record. Leave empty for an empty
                        text default. Unlink the operation to drop it.
                    </div>
                </t>
                <t t-if="state.action === 'set_widget'">
                    <div class="mb-3">
                        <label class="form-label">Widget</label>
                        <input
                            type="text"
                            class="form-control"
                            list="esc_cust_widgets"
                            placeholder="many2many_tags"
                            t-att-value="state.widget"
                            t-on-input="(ev) => state.widget = ev.target.value"
                        />
                        <datalist id="esc_cust_widgets">
                            <t t-foreach="fieldWidgets" t-as="widget" t-key="widget">
                                <option t-att-value="widget" />
                            </t>
                        </datalist>
                    </div>
                </t>
                <t t-if="state.action === 'set_optional'">
                    <div class="mb-3">
                        <label class="form-label">Column visibility</label>
                        <select
                            class="form-select"
                            t-on-change="(ev) => state.optional = ev.target.value"
                        >
                            <option
                                value="hide"
                                t-att-selected="state.optional === 'hide'"
                            >Hidden by default</option>
                            <option
                                value="show"
                                t-att-selected="state.optional === 'show'"
                            >Shown by default</option>
                        </select>
                        <div class="form-text">
                            The column moves to the list column picker, so users
                            can turn it on themselves.
                        </div>
                    </div>
                </t>
                <t t-if="state.action === 'set_groups'">
                    <div class="mb-3">
                        <label class="form-label">Groups</label>
                        <MultiRecordSelector
                            resIds="state.groupIds"
                            resModel="'res.groups'"
                            update.bind="onGroupsUpdate"
                            fieldString.translate="Groups"
                            placeholder.translate="Search a group..."
                        />
                        <div class="form-text">
                            The node is shown only to users in those groups.
                        </div>
                    </div>
                </t>
                <t t-if="state.action === 'set_modifier'">
                    <p class="text-muted">
                        Use True to always apply, or an expression such as
                        not is_company.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Invisible</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="True"
                            t-att-value="state.modInvisible"
                            t-on-input="(ev) => state.modInvisible = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Readonly</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="True"
                            t-att-value="state.modReadonly"
                            t-on-input="(ev) => state.modReadonly = ev.target.value"
                        />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Required</label>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="True"
                            t-att-value="state.modRequired"
                            t-on-input="(ev) => state.modRequired = ev.target.value"
                        />
                    </div>
                </t>
                <div class="form-check mb-2">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="esc_cust_apply"
                        t-att-checked="state.apply"
                        t-on-change="(ev) => state.apply = ev.target.checked"
                    />
                    <label class="form-check-label" for="esc_cust_apply">
                        Apply immediately
                    </label>
                </div>
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary"
                    t-att-disabled="state.busy || !state.bundles.length || state.loadError"
                    t-on-click="onApply"
                >
                    Apply
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
