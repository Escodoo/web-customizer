<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_customizer.Field" t-inherit="web.Field" t-inherit-mode="extension">
        <xpath expr="//div" position="attributes">
            <attribute name="t-on-click.capture">onCustomizationClick</attribute>
        </xpath>
    </t>
    <t
        t-name="web_customizer.ViewButton"
        t-inherit="web.views.ViewButton"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@t-tag='props.tag']" position="attributes">
            <attribute name="t-on-click.capture">onCustomizationCapture</attribute>
        </xpath>
    </t>
    <t
        t-name="web_customizer.FormLabel"
        t-inherit="web.FormLabel"
        t-inherit-mode="extension"
    >
        <xpath expr="//label" position="attributes">
            <attribute name="t-on-click">onCustomizationClick</attribute>
        </xpath>
    </t>
    <t
        t-name="web_customizer.Notebook"
        t-inherit="web.Notebook"
        t-inherit-mode="extension"
    >
        <xpath expr="//a[hasclass('nav-link')]" position="attributes">
            <attribute
                name="t-on-click.prevent"
            >(ev) => this.onCustomizationNavClick(ev, navItem)</attribute>
        </xpath>
    </t>
    <t
        t-name="web_customizer.InnerGroup"
        t-inherit="web.Form.InnerGroup"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//div[hasclass('o_inner_group')]/div[not(hasclass('o_wrap_field'))]"
            position="attributes"
        >
            <attribute name="t-on-click">onCustomizationClick</attribute>
            <attribute
                name="t-attf-class"
            >g-col-sm-{{ props.maxCols }} {{ customizationTargetClass }}</attribute>
        </xpath>
    </t>
    <t
        t-name="web_customizer.OuterGroup"
        t-inherit="web.Form.OuterGroup"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@t-slot='title']" position="replace">
            <div
                t-if="props.slots and props.slots.title"
                t-att-class="customizationTargetClass"
                t-on-click="onCustomizationClick"
            >
                <t t-slot="title" />
            </div>
        </xpath>
    </t>
</templates>
